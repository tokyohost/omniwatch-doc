{
  "protocol": 2,
  "key": "demo_sensor2",
  "name": "demo_sensor2",
  "zh_name": "演示传感器2",
  "interval": 5,
  "config_panel": [
    {
      "name": "temperature_base",
      "zh_name": "基础温度",
      "key": "temperature_base",
      "type": "number",
      "default": 26,
      "min": -40,
      "max": 100,
      "decimal": 1
    },
    {
      "name": "humidity_base",
      "zh_name": "基础湿度",
      "key": "humidity_base",
      "type": "number",
      "default": 55,
      "min": 0,
      "max": 100,
      "decimal": 1
    },
    {
      "kind": "field",
      "name": "application_path",
      "zh_name": "演示应用安装目录",
      "key": "application_path",
      "type": "string",
      "default": "",
      "readonly": true
    },
    {
      "kind": "action",
      "action": "detect_application",
      "zh_name": "自动检测安装目录",
      "style": "primary",
      "confirm": false,
      "loading_text": "正在检测安装目录……"
    }
  ],
  "actions": {
    "detect_application": {
      "method": "detect_application",
      "timeout": 10,
      "config_keys": [
        "application_path"
      ],
      "description": "从环境变量或当前 Python Runtime 推断演示应用目录"
    }
  },
  "uninstall": true,
  "entry": "main.py",
  "bind_style": true,
  "style": "style_demo_sensor2.py",
  "bind_detail": true,
  "detail": "demo_sensor2_detail.html",
  "bind_preview": true,
  "preview": "preview.png"
}
